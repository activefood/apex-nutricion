{
  "name": "apex-nutricion",
  "compatibility_date": "2026-09-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  // Base D1 de la calculadora (la misma del sitio de prueba): /api/calculadora
  // guarda ahí las respuestas con consentimiento.
  "d1_databases": [
    {
      "binding": "CALC_DB",
      "database_name": "apex-calculadora",
      "database_id": "2f86abbf-8cfb-46fc-ba2f-b2f246fbbf3b"
    }
  ],
  // Supabase = donde viven los pedidos, el panel, el cupón, las reseñas y los datos de marketing.
  // PEDIDOS_BACKEND debe quedar en "supabase" (es el único backend que existe). SUPABASE_KEY es la llave PÚBLICA (la de la
  // página, sin permisos sobre los datos de clientes); los secretos SUPABASE_RPC_TOKEN y GA4_API_SECRET se ponen en
  // Cloudflare (Variables and Secrets), nunca aquí.
  "vars": {
    "SUPABASE_URL": "https://ngbrcbweduazaoidavza.supabase.co",
    "SUPABASE_KEY": "sb_publishable_7wtBmKVZmCDBa1dgi5yLvA_bHBeG5sK",
    "PEDIDOS_BACKEND": "supabase",
    // Avisos del newsletter por correo (el producto que vio el suscriptor). "off" = no se manda nada; pasar a "on" solo con el visto bueno del dueño.
    "NEWSLETTER_AVISOS": "off",
    // Adónde llegan las respuestas a los correos del newsletter (el dominio no tiene buzón propio). Va como "reply_to" en cada correo.
    // "+newsletter" es una marca de Gmail: llega a la misma bandeja de activefoodtradingve@gmail.com y un filtro la manda a la etiqueta "Newsletter Apex" (sin mezclarse con facturación).
    "NEWSLETTER_RESPONDER": "activefoodtradingve+newsletter@gmail.com",
    "GA4_MEASUREMENT_ID": "G-CKJ8VQSLLE",
    // Dirección CSV de la hoja "APEX - Cargar descuentos" (pestaña DESCUENTOS, publicada en la web). Si falla o está vacía, el sitio usa su copia de respaldo.
    "PROMOS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRpGABeVDswHP9EGAwH4fVxTnNg8U3AgJMGEr2j0c6cvwqCIyxHyXOUEjYgPYEv2HxqOvcL6PRC_qVX/pub?gid=0&single=true&output=csv"
  },
  // Cada hora (minuto 17): manda a GA4 las ventas confirmadas que no se hayan enviado. Lunes 8:00 y viernes 16:00 (hora
  // de Caracas, UTC-4; con nombre de día porque en Cloudflare 1 = domingo) el recordatorio de pedidos pendientes por correo, con un reintento una hora después. Solo actúan con "supabase".
  "triggers": { "crons": ["17 * * * *", "0 12 * * MON", "0 13 * * MON", "0 20 * * FRI", "0 21 * * FRI"] },
  // Límite de peticiones por IP (ver guardPublicApi en worker/index.js).
  // Pedidos: 5 por minuto por IP — varias personas pueden compartir IP en
  // las redes móviles de Venezuela, así que no se baja de ahí.
  // El resto de /api/* (reseñas, cupón): 30 por minuto por IP.
  "ratelimits": [
    { "name": "ORDER_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
