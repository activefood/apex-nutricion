{
  "name": "apex-nutricion",
  "compatibility_date": "2026-09-11",
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  // Base D1 de la calculadora (la misma del sitio de prueba): /api/calculadora
  // guarda ahí las respuestas con consentimiento.
  "d1_databases": [
    {
      "binding": "CALC_DB",
      "database_name": "apex-calculadora",
      "database_id": "2f86abbf-8cfb-46fc-ba2f-b2f246fbbf3b"
    }
  ],
  // Supabase = donde viven los pedidos (reemplaza al Apps Script y a la hoja de Google). PEDIDOS_BACKEND decide
  // quién atiende los pedidos, el panel, el cupón y las reseñas: "appsscript" (como hasta ahora) o "supabase".
  // Para volver atrás basta con poner "appsscript" y subir el cambio. SUPABASE_KEY es la llave PÚBLICA (la de la
  // página, sin permisos sobre los datos de clientes); los secretos SUPABASE_RPC_TOKEN y GA4_API_SECRET se ponen en
  // Cloudflare (Variables and Secrets), nunca aquí.
  "vars": {
    "SUPABASE_URL": "https://ngbrcbweduazaoidavza.supabase.co",
    "SUPABASE_KEY": "sb_publishable_7wtBmKVZmCDBa1dgi5yLvA_bHBeG5sK",
    "PEDIDOS_BACKEND": "appsscript",
    "GA4_MEASUREMENT_ID": "G-CKJ8VQSLLE"
  },
  // Cada hora (minuto 17): manda a GA4 las ventas confirmadas que no se hayan enviado. Solo actúa con "supabase".
  "triggers": { "crons": ["17 * * * *"] },
  // Límite de peticiones por IP (ver guardPublicApi en worker/index.js).
  // Pedidos: 5 por minuto por IP — varias personas pueden compartir IP en
  // las redes móviles de Venezuela, así que no se baja de ahí.
  // El resto de /api/* (reseñas, cupón): 30 por minuto por IP.
  "ratelimits": [
    { "name": "ORDER_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
